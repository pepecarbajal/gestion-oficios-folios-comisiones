<%- include('partials/header') %>

  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-top">
        <nav class="nav">
          <div class="nav-section">
            <span class="nav-item nav-header">OFICIOS EXT.</span>
            <div class="subnav">
              <a href="#" class="subnav-item active" id="navOfPendientes" onclick="cambiarTab('oficios-pendientes', event)">Pendientes</a>
              <a href="#" class="subnav-item" id="navOfAtendidos" onclick="cambiarTab('oficios-atendidos', event)">Atendidos</a>
            </div>
          </div>
          <div class="nav-section">
            <span class="nav-item nav-header">OFICIOS SFDC</span>
            <div class="subnav">
              <a href="#" class="subnav-item" id="navFolPendientes" onclick="cambiarTab('folios-pendientes', event)">Folios</a>
              <a href="#" class="subnav-item" id="navFolAtendidos" onclick="cambiarTab('folios-atendidos', event)">Atendidos</a>
            </div>
          </div>
        </nav>
      </div>
      <div class="sidebar-bottom">
        <span class="rol-label"><%= unidadAlias || 'Unidad Administrativa' %></span>
        <form action="/logout" method="POST" style="margin:0" id="formLogout">
          <input type="hidden" name="_csrf" id="csrfLogout">
          <button type="submit" class="logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
               <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
               <polyline points="16 17 21 12 16 7"/>
               <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Salir
          </button>
        </form>
      </div>
    </aside>
    <main class="main">
      <div id="tabOfPendientes" class="content-card tab-panel">
        <div class="card-header">
          <div class="filters">
            <div class="search-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input type="text" id="searchPendientes" placeholder="Buscar..." class="search-input">
            </div>
            <select id="filterEstatusPend" class="filter-select">
              <option value="">Todos</option>
              <option value="Pendiente">Pendiente</option>
              <option value="Vencido">Vencido</option>
            </select>
          </div>
        </div>

        <table class="table">
          <colgroup>
            <col style="width:48px">   <!-- icono tipo -->
            <col style="width:13%">    <!-- No. Oficio -->
            <col style="width:18%">    <!-- Remitente -->
            <col style="width:32%">    <!-- Asunto -->
            <col style="width:15%">    <!-- Fecha -->
            <col style="width:10%">    <!-- Prioridad -->
            <col style="width:80px">   <!-- Acción -->
          </colgroup>
          <thead>
            <tr>
              <th></th>
              <th>No.</th>
              <th>Remitente</th>
              <th>Asunto</th>
              <th>Fecha</th>
              <th>Prioridad</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody id="tbodyPendientes">
            <% if (oficiosPend.length === 0) { %>
              <tr><td colspan="7" class="empty-state">No tienes oficios pendientes.</td></tr>
            <% } %>
              <% oficiosPend.forEach(o => {
                 const limite = o.fechaLimite ? new Date(o.fechaLimite) : null;
                 if (limite) limite.setHours(23,59,59,999);
                 const vencido = limite && limite < new Date();
                 const urgente = !vencido && limite && (limite - new Date()) / (1000 * 60 * 60 * 24) <= 6;
                 const prioridad = vencido ? 'vencido' : urgente ? 'urgente' : 'en-tiempo';
                 const estatusGlobal = vencido ? 'Vencido' : o.estatus;
                 const initials = o.remitente ? o.remitente.slice(0,2).toUpperCase() : '??';
                 const respuestas = o.respuestas || [];
                 const miRespuesta = respuestas.find(r => r.unidadId === unidadId);
                 const yaRespondio = !!miRespuesta;
                 const esCorreo = (o.tipoArchivo === 1);
              %>
                  <tr class="oficio-row pend-row"
                    data-estatus="<%= estatusGlobal %>"
                    data-search="<%= (o.noOficio + ' ' + o.remitente + ' ' + o.asunto).toLowerCase() %>"
                    data-id="<%= o.id %>"
                    data-ya="<%= yaRespondio %>"
                    data-comentario="<%= miRespuesta ? miRespuesta.comentario || '' : '' %>"
                    data-archivos="<%= miRespuesta ? JSON.stringify(miRespuesta.archivos || []) : '[]' %>"
                    data-esresponsable="<%= coresponsableMap[o.id]?.esResponsable || false %>"
                    data-ecooresponsable="<%= coresponsableMap[o.id]?.esCoResponsable || false %>"
                    data-aliasresponsable="<%= coresponsableMap[o.id]?.aliasResponsable || '' %>">
                    <script type="application/json" id="oficio-data-<%= o.id %>"><%- JSON.stringify({
                       id: o.id, noOficio: o.noOficio, archivoUrl: o.archivoUrl || "", modo: o.modo || 0
                     }).replace(/<\/script>/gi, '<\\/script>') %></script>
                    <td>
                    <% if (o.modo === 1) { %>
                      <span class="tipo-icon tipo-icon-conocimiento" title="De conocimiento">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
</span>
                    <% } else if (esCorreo) { %>
                      <span class="tipo-icon tipo-icon-correo" title="Correo electrónico">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                      </span>
                    <% } else { %>
                      <span class="tipo-icon tipo-icon-oficio" title="Oficio">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                      </span>
                    <% } %>
                  </td>
                  <td class="no-cell"><%= o.noOficio %></td>
                  <td>
                    <%- include('partials/user-cell', { name: o.remitente, initials: initials, cargo: o.cargo }) %>
                  </td>
                  <td class="asunto-cell" title="<%= o.asunto %>"><%= o.asunto %></td>
                  <td class="fecha-cell">
                    <%= o.fechaOficio
                      ? new Date(o.fechaOficio).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'})
                      : '—' %>
                    <% if (o.fechaLimite) { %>
                      <span class="fecha-limite <%= vencido ? 'vencida' : '' %>">Límite: <%= new Date(o.fechaLimite).toLocaleDateString('es-MX', {day:'2-digit',month:'short'}) %></span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge badge-prioridad badge-<%= prioridad %>"><%= prioridad === 'vencido' ? 'Vencido' : prioridad === 'urgente' ? 'Urgente' : 'En tiempo' %></span>
                    <% if (coresponsableMap[o.id]?.esCoResponsable) { %>
                      <span class="badge-coresponsable" style="display:inline-block;font-size:0.7rem;background:#fef3c7;color:#92400e;padding:2px 6px;border-radius:4px;margin-top:3px">Co-responsable</span>
                    <% } %>
                    <% if (o.modo === 1) { %>
                      <br><span style="display:inline-block;font-size:0.7rem;background:#e0f2fe;color:#0369a1;padding:2px 6px;border-radius:4px;margin-top:3px">De conocimiento</span>
                    <% } %>
                  </td>
                  <td class="actions-cell">
                    <button class="menu-btn" onclick="toggleActionMenu(event, '<%= o.id %>')" title="Acciones">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                    </button>
                  </td>
                </tr>


            <% }) %>
          </tbody>
        </table>
      </div>
      <div id="tabOfAtendidos" class="content-card tab-panel" style="display:none">
        <div class="card-header">
          <div class="filters">
            <div class="search-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="searchAtendidos" placeholder="Buscar..." class="search-input">
            </div>
          </div>
        </div>

        <% if (oficiosAtend.length === 0) { %>
          <div class="empty-state-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <p>Aún no has respondido ningún oficio.</p>
          </div>
        <% } else { %>
          <table class="table">
            <colgroup>
              <col style="width:48px">   <!-- icono tipo -->
              <col style="width:13%">    <!-- No. Oficio -->
              <col style="width:18%">    <!-- Remitente -->
              <col style="width:34%">    <!-- Asunto -->
              <col style="width:11%">    <!-- Fecha -->
              <col style="width:10%">    <!-- Respondido -->
              <col style="width:80px">   <!-- Acción -->
            </colgroup>
            <thead>
              <tr>
                <th></th>
                <th>No.</th>
                <th>Remitente</th>
                <th>Asunto</th>
                <th>Fecha oficio</th>
                <th>Respondido</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="tbodyAtendidos">
               <% oficiosAtend.forEach(o => {
                   const todasRespuestas = o.respuestas || [];
                   const miRespuesta = todasRespuestas.find(r => r.unidadId === unidadId && !r.esAclaracion);
                   const misAclaraciones = todasRespuestas.filter(r => r.unidadId === unidadId && r.esAclaracion);
                   const initials = o.remitente ? o.remitente.slice(0,2).toUpperCase() : '??';
                   const archivos = (miRespuesta?.archivos) || [];
                   const esCorreo = (o.tipoArchivo === 1);
                   const esCoResponsable = coresponsableMap[o.id]?.esCoResponsable;
                   // co-responsables should not see response details
                   const respuestasVisibles = esCoResponsable ? [] : todasRespuestas;
                   const comentarioVisible = esCoResponsable ? '' : (miRespuesta?.comentario || '');
                   const archivosVisibles = esCoResponsable ? '[]' : JSON.stringify(miRespuesta?.archivos || []);
                %>
                     <tr class="oficio-row atend-row atendido-row"
                       data-search="<%= (o.noOficio + ' ' + o.remitente + ' ' + o.asunto).toLowerCase() %>"
                       data-id="<%= o.id %>"
                       data-ya="true"
                       data-comentario="<%= comentarioVisible %>"
                       data-archivos="<%= archivosVisibles %>"
                       data-esresponsable="<%= coresponsableMap[o.id]?.esResponsable || false %>"
                       data-ecooresponsable="<%= coresponsableMap[o.id]?.esCoResponsable || false %>"
                       data-aliasresponsable="<%= coresponsableMap[o.id]?.aliasResponsable || '' %>">
                     <script type="application/json" id="oficio-data-<%= o.id %>"><%- JSON.stringify({
                        id: o.id, noOficio: o.noOficio, archivoUrl: o.archivoUrl || "", modo: o.modo || 0
                      }).replace(/<\/script>/gi, '<\\/script>') %></script>
                     <script type="application/json" id="resp-data-<%= o.id %>"><%- JSON.stringify(respuestasVisibles).replace(/<\/script>/gi,'<\/script>') %></script>
                     <script>
                       window.__respuestas = window.__respuestas || {};
                       window.__respuestas['<%= o.id %>'] = JSON.parse(document.getElementById('resp-data-<%= o.id %>').textContent);
                     </script>
                    <td>
                    <% if (o.modo === 1) { %>
                      <span class="tipo-icon tipo-icon-conocimiento" title="De conocimiento">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
</span>
                    <% } else if (esCorreo) { %>
                      <span class="tipo-icon tipo-icon-correo" title="Correo electrónico">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                      </span>
                    <% } else { %>
                      <span class="tipo-icon tipo-icon-oficio" title="Oficio">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                      </span>
                    <% } %>
                  </td>
                   <td>
                    <span class="resp-fecha-cell"><%
                      const __lrUad = todasRespuestas.filter(r => r.unidadId === unidadId).reduce((__a, __r) => {
                        const __d = new Date(__r.fechaAtendido);
                        return (!__a || __d > __a) ? __d : __a;
                      }, null);
                      %><%= __lrUad ? __lrUad.toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '' %></span>
                    <span class="no-cell"><%= o.noOficio %></span>
                  </td>
                  <td>
                    <%- include('partials/user-cell', { name: o.remitente, initials: initials, cargo: o.cargo }) %>
                  </td>
                  <td class="asunto-cell" title="<%= o.asunto %>"><%= o.asunto %></td>
                  <td class="fecha-cell">
                    <%= o.fechaOficio
                      ? new Date(o.fechaOficio).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'})
                      : '—' %>
                  </td>
                  <td class="fecha-cell">
                    <% if (coresponsableMap[o.id]?.esCoResponsable) { %>
                      <span class="respondido-fecha">Atendido por <%= coresponsableMap[o.id]?.aliasResponsable || '—' %></span>
                    <% } else { %>
                      <span class="respondido-fecha">
                        <%= new Date(miRespuesta.fechaAtendido).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) %>
                      </span>
                      <% if (miRespuesta.comentario) { %>
                        <span class="respondido-comentario" title="<%= miRespuesta.comentario %>">"<%= miRespuesta.comentario %>"</span>
                      <% } %>
                      <% if (misAclaraciones.length > 0) { %>
                        <div class="aclaraciones-list">
                          <% misAclaraciones.forEach(a => { %>
                            <div class="aclaracion-item-inline">
                              <span class="aclaracion-label">Nota aclaratoria: </span>
                              <span><%= a.comentario %></span>
                            </div>
                          <% }) %>
                        </div>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="actions-cell">
                    <button class="menu-btn" onclick="toggleActionMenu(event, '<%= o.id %>')" title="Acciones">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                    </button>
                  </td>
                </tr>


              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <%# ════════════ FOLIOS PENDIENTES ════════════ %>
      <div id="tabFolPendientes" class="content-card tab-panel" style="display:none">
        <div class="card-header">
          <div class="filters">
            <div class="search-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="searchFolPend" placeholder="Buscar..." class="search-input">
            </div>
          </div>
          <button class="btn-primary" id="btnSolicitarFolio" onclick="abrirModalSolicitarFolio()">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Solicitar
          </button>
        </div>
        <table class="table" id="tablaUadFolPend">
          <colgroup>
            <col style="width:12%">
            <col style="width:24%">
            <col style="width:44%">
            <col style="width:16%">
            <col style="width:4%">
          </colgroup>
          <thead>
            <tr>
              <th>No. Folio</th>
              <th>Destinatario</th>
              <th>Asunto</th>
              <th>Fecha solicitud</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody id="tbodyFolPend">
            <% if (foliosPend.length === 0) { %>
              <tr><td colspan="5" class="empty-state">No hay folios pendientes.</td></tr>
            <% } %>
            <% foliosPend.forEach(f => { %>
              <tr class="folio-row fol-pend-row"
                data-search="<%= (f.noFolio + ' ' + f.destinatario + ' ' + f.dependencia + ' ' + f.cargo + ' ' + f.asunto).toLowerCase() %>"
                data-id="<%= f.id %>"
                data-estatus="<%= f.estatus %>">
                <script type="application/json" id="folio-data-<%= f.id %>"><%- JSON.stringify({
                   id: f.id, noFolio: f.noFolio, archivoUrl: f.archivoUrl || ""
                 }).replace(/<\/script>/gi, '<\\/script>') %></script>
                <td class="no-cell"><%= f.noFolio %></td>
                <td>
                  <%- include('partials/user-cell', { name: f.destinatario, cargo: f.cargo, dependencia: f.dependencia }) %>
                </td>
                <td class="asunto-cell" title="<%= f.asunto %>"><%= f.asunto %></td>
                <td class="fecha-cell">
                  <%= new Date(f.fechaSolicitud).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) %>
                </td>
                <td class="actions-cell">
                  <button class="menu-btn" onclick="toggleFolioActionMenu(event, '<%= f.id %>')" title="Acciones">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <%# ════════════ FOLIOS ATENDIDOS ════════════ %>
      <div id="tabFolAtendidos" class="content-card tab-panel" style="display:none">
        <div class="card-header">
          <div class="filters">
            <div class="search-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="searchFolAtend" placeholder="Buscar..." class="search-input">
            </div>
          </div>
        </div>
        <% if (foliosAtend.length === 0) { %>
          <div class="empty-state-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <p>No hay folios atendidos.</p>
          </div>
        <% } else { %>
          <table class="table" id="tablaUadFolAtend">
            <colgroup>
              <col style="width:10%">
              <col style="width:20%">
              <col style="width:32%">
              <col style="width:10%">
              <col style="width:10%">
              <col style="width:14%">
              <col style="width:4%">
            </colgroup>
            <thead>
              <tr>
                <th>No. Folio</th>
                <th>Destinatario</th>
                <th>Asunto</th>
                <th>Fecha solicitud</th>
                <th>Fecha entrega</th>
                <th>Comentario</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="tbodyFolAtend">
              <% foliosAtend.forEach(f => { %>
                <tr class="folio-row fol-atend-row<%= f.estatus === 'Cancelado' ? ' folio-cancelado' : '' %>"
                  data-search="<%= (f.noFolio + ' ' + f.destinatario + ' ' + f.dependencia + ' ' + f.cargo + ' ' + f.asunto).toLowerCase() %>"
                  data-id="<%= f.id %>"
                  data-estatus="<%= f.estatus %>">
                  <script type="application/json" id="folio-data-<%= f.id %>"><%- JSON.stringify({
                     id: f.id, noFolio: f.noFolio, archivoUrl: f.archivoUrl || ""
                   }).replace(/<\/script>/gi, '<\\/script>') %></script>
                   <td>
                    <span class="resp-fecha-cell"><%= f.estatus !== 'Cancelado' && f.fechaEntrega ? new Date(f.fechaEntrega).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '' %></span>
                    <span class="no-cell"><%= f.noFolio %></span>
                  </td>
                  <td>
                    <%- include('partials/user-cell', { name: f.destinatario, cargo: f.cargo, dependencia: f.dependencia }) %>
                  </td>
                  <td class="asunto-cell" title="<%= f.asunto %>"><%= f.asunto %></td>
                  <td class="fecha-cell">
                    <%= new Date(f.fechaSolicitud).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) %>
                  </td>
                  <td class="fecha-cell">
                    <% if (f.estatus === 'Cancelado') { %>
                      <span class="badge-cancelado">Cancelado</span>
                    <% } else { %>
                      <%= f.fechaEntrega ? new Date(f.fechaEntrega).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) : '—' %>
                    <% } %>
                  </td>
                  <td><% if (f.estatus === 'Cancelado') { %><span class="badge-cancelado">Cancelado</span><% } else { %><%= f.comentario || '—' %><% } %></td>
                  <td class="actions-cell">
                    <button class="menu-btn" onclick="toggleFolioActionMenu(event, '<%= f.id %>')" title="Acciones">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
      <div class="pagination-fixed-wrap" id="unifiedPagination" style="display:none">
        <span id="paginacionInfoUnified">Mostrando 0 de 0</span>
        <div class="page-controls" id="pageControlsUnified"></div>
      </div>
    </main>
  </div>

