<%- include('partials/header') %>

  <style>
    /* ══════════════════════════════════════════════
       AOF TABLE — layout fijo, sin superposición
       ══════════════════════════════════════════════ */

    /* Ambas tablas usan layout fijo; los anchos los
       define el <colgroup> declarado en el HTML.      */
    #tablaOficios,
    #tablaAtendidos {
      table-layout: fixed;
      width: 100%;
      border-collapse: collapse;
    }

    /* Todas las celdas: padding uniforme y wrap seguro */
    #tablaOficios th,  #tablaOficios td,
    #tablaAtendidos th, #tablaAtendidos td {
      padding: 10px 10px;
      vertical-align: middle;
      overflow: hidden;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    /* Col 1 — icono tipo: alineado a la izquierda */
    #tablaOficios th:nth-child(1),  #tablaOficios td:nth-child(1),
    #tablaAtendidos th:nth-child(1), #tablaAtendidos td:nth-child(1) {
      text-align: left;
      padding-left: 12px;
      padding-right: 4px;
    }

    /* Col 2 — No. Oficio: fuente monospace pequeña */
    .no-cell {
      font-family: 'DM Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      color: #6b7280;
      word-break: break-all;   /* rompe cadenas largas sin espacios */
    }

    /* Col 4 — Asunto */
    .asunto-cell {
      font-size: 0.83rem;
      color: #374151;
      line-height: 1.45;
      white-space: normal;
      word-break: break-word;
    }

    /* Col 5 — Fecha: texto pequeño, fecha límite en línea propia */
    .fecha-cell {
      font-size: 0.83rem;
      white-space: normal;
      line-height: 1.4;
    }

    /* Col 6 — Unidad: puede truncar con ellipsis si es muy larga */
    #tablaOficios td:nth-child(6),
    #tablaAtendidos td:nth-child(6) {
      font-size: 0.82rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Col 7 — Prioridad / Respuestas */
    #tablaOficios td:nth-child(7),
    #tablaAtendidos td:nth-child(7) {
      white-space: nowrap;
    }

    /* Col 8 — Acción: alineado a la izquierda */
    #tablaOficios td:nth-child(8),
    #tablaAtendidos td:nth-child(8) {
      text-align: left;
      white-space: nowrap;
      padding-left: 4px;
      padding-right: 8px;
    }

    /* Col 3 — Remitente: nombre puede partir, cargo trunca */
    .user-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
    .user-cell strong { word-break: break-word; font-size: 0.875rem; }
    .user-cell .cargo-txt {
      display: block;
      font-size: 0.74rem;
      color: #9ca3af;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    /* ── ICONO TIPO ── */
    .tipo-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px; height: 32px;
      border-radius: 8px;
      flex-shrink: 0;
    }
    .tipo-icon-oficio { background: #fef2f2; color: #dc2626; }
    .tipo-icon-correo { background: #eff6ff; color: #2563eb; }

    /* ── BOTONES DE ACCIÓN ── */
    .icon-btn-lg {
      color: #9ca3af;
      background: none;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px;
      border-radius: 7px;
      transition: color 0.18s, background 0.15s;
      text-decoration: none;
    }
    .icon-btn-lg:hover { color: #1a1a2e; background: #f0f2f5; }
    .icon-btn-lg svg   { width: 17px; height: 17px; }

    .actions-cell {
      display: flex !important;
      align-items: center;
      justify-content: flex-start;
      gap: 1px;
    }

    /* ── CHECKBOX ROW EN MODAL ── */
    .check-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      background: #f9fafb;
      border: 1.5px solid #e2e8f0;
      border-radius: 8px;
      cursor: pointer;
      user-select: none;
      transition: border-color 0.2s, background 0.2s;
    }
    .check-row:hover { border-color: #2563eb; background: #eff6ff; }
    .check-row input[type="checkbox"] {
      width: 16px; height: 16px;
      accent-color: #2563eb;
      cursor: pointer;
      flex-shrink: 0;
      border: none; background: none; padding: 0;
    }
    .check-row-label {
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .check-row-label svg { color: #2563eb; flex-shrink: 0; }
  </style>

  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-top">
        <nav class="nav">
          <a href="#" class="nav-item active" id="navOficios" onclick="cambiarTab('oficios', event)">Oficios</a>
          <a href="#" class="nav-item" id="navAtendidos" onclick="cambiarTab('atendidos', event)">Atendidos</a>
        </nav>
      </div>
      <div class="sidebar-bottom">
        <span class="rol-label">Asistente de Folios</span>
        <form action="/logout" method="POST" style="margin:0" id="formLogout">
          <input type="hidden" name="_csrf" id="csrfLogout">
          <button type="submit" class="logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Salir
          </button>
        </form>
      </div>
    </aside>

    <main class="main">

      <!-- ═══════════════ TAB OFICIOS ═══════════════ -->
      <div id="tabOficios" class="content-card tab-panel">
        <div class="card-header">
          <div class="filters">
            <div class="search-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="searchOficios" placeholder="Buscar..." class="search-input">
            </div>
            <select id="filterEstatusOf" class="filter-select">
              <option value="">Todos</option>
              <option value="Pendiente">Pendiente</option>
              <option value="Vencido">Vencido</option>
            </select>
            <select id="filterUnidadOf" class="filter-select">
              <option value="">Todas las unidades</option>
              <option value="TODAS">TODAS</option>
              <% unidades.forEach(u => { %>
                <option value="<%= u.alias %>"><%= u.alias %></option>
              <% }) %>
            </select>
          </div>
          <button class="btn-primary" id="btnNuevoOficio">+ Registrar</button>
        </div>

        <table class="table" id="tablaOficios">
          <colgroup>
            <col style="width:48px">      <!-- icono tipo   -->
            <col style="width:13%">       <!-- No. Oficio   -->
            <col style="width:18%">       <!-- Remitente    -->
            <col style="width:32%">       <!-- Asunto       -->
            <col style="width:11%">       <!-- Fecha        -->
            <col style="width:8%">        <!-- Unidad       -->
            <col style="width:10%">       <!-- Prioridad    -->
            <col style="width:80px">      <!-- Acción       -->
          </colgroup>
           <thead>
             <tr>
               <th></th>
               <th>NO.</th>
               <th>REMITENTE</th>
               <th>ASUNTO</th>
               <th>FECHA</th>
               <th>UNIDAD</th>
               <th>PRIORIDAD</th>
               <th>ACCIÓN</th>
             </tr>
           </thead>

          <tbody id="tbodyOficios">
            <% if (oficiosPend.length === 0) { %>
              <tr><td colspan="8" class="empty-state">No hay oficios pendientes.</td></tr>
            <% } %>
            <% oficiosPend.forEach(o => {
               const limite = o.fechaLimite ? new Date(o.fechaLimite) : null;
               if (limite) limite.setHours(23,59,59,999);
               const vencido = limite && limite < new Date();
               const urgente = !vencido && limite && (limite - new Date()) / (1000 * 60 * 60 * 24) <= 6;
               const prioridad = vencido ? 'vencido' : urgente ? 'urgente' : 'en-tiempo';
               const estatus = vencido ? 'Vencido' : o.estatus;
               const initials = o.remitente ? o.remitente.slice(0,2).toUpperCase() : '??';
               const respuestas = o.respuestas || [];
               const esCorreo = (o.tipoArchivo === 1);
            %>
              <tr class="oficio-row of-row"
                data-estatus="<%= estatus %>"
                data-unidad="<%= o.unidadAlias || '' %>"
                data-search="<%= (o.noOficio + ' ' + o.remitente + ' ' + o.asunto).toLowerCase() %>"
                data-id="<%= o.id %>">

                 <script type="application/json" id="oficio-data-<%= o.id %>"><%- JSON.stringify({
                   id: o.id,
                   noOficio: o.noOficio,
                   fechaOficio: o.fechaOficio || "",
                   fechaRecibo: o.fechaRecibo || "",
                   fechaLimite: o.fechaLimite || "",
                   asunto: o.asunto,
                   remitente: o.remitente,
                   cargo: o.cargo || "",
                   dependencia: o.dependencia || "",
                   unidadId: o.unidadId || "",
                   estatus: o.estatus,
                   tipoArchivo: o.tipoArchivo || 0,
                   tieneArchivo: !!o.archivoPath,
                   archivoUrl: o.archivoUrl || ""
                 }).replace(/<\/script>/gi, '<\\/script>') %></script>


                <!-- Icono tipo: rojo=oficio, azul=correo -->
                <td>
                  <% if (esCorreo) { %>
                    <span class="tipo-icon tipo-icon-correo" title="Correo electrónico">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </span>
                  <% } else { %>
                    <span class="tipo-icon tipo-icon-oficio" title="Oficio">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                    </span>
                  <% } %>
                </td>

                <td class="no-cell"><%= o.noOficio %></td>
                <td><%- include('partials/user-cell', { name: o.remitente, initials: initials, cargo: o.cargo }) %></td>
                <td class="asunto-cell"><%= o.asunto %></td>
                <td class="fecha-cell">
                  <%= o.fechaOficio ? new Date(o.fechaOficio).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) : '—' %>
                  <% if (o.fechaLimite) { %>
                    <span class="fecha-limite <%= vencido ? 'vencida' : '' %>">Límite: <%= new Date(o.fechaLimite).toLocaleDateString('es-MX', {day:'2-digit',month:'short'}) %></span>
                  <% } %>
                </td>
                <td><%= o.unidadAlias || '—' %></td>
                <td>
                  <span class="badge badge-prioridad badge-<%= prioridad %>">
                    <%= prioridad === 'vencido' ? 'Vencido' : prioridad === 'urgente' ? 'Urgente' : 'En tiempo' %>
                  </span>
                </td>
                    <td class="actions-cell">
                      <button class="menu-btn" onclick="toggleActionMenu(event, '<%= o.id %>')" title="Acciones">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                      </button>
                    </td>



               </tr>


              <tr class="respuestas-row" id="resp-<%= o.id %>" style="display:none">
                <td colspan="8">
                  <div class="respuestas-panel">
                    <% respuestas.forEach(r => { %>
                      <div class="respuesta-item">
                        <div class="respuesta-body">
                          <div class="respuesta-header">
                            <span class="resp-alias"><%= r.unidadAlias %></span>
                            <span class="resp-fecha">Atendido: <%= new Date(r.fechaAtendido).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric', hour:'2-digit', minute:'2-digit'}) %></span>
                          </div>
                          <% if (r.comentario || (r.archivos && r.archivos.length > 0)) { %><div class="respuesta-divider"></div><% } %>
                          <% if (r.comentario) { %><p class="resp-comentario">"<%= r.comentario %>"</p><% } %>
                          <% if (r.archivos && r.archivos.length > 0) { %>
                            <div class="resp-archivos">
                              <% r.archivos.forEach(a => { %><%- include('partials/file-chip', { url: a.url, tipo: a.tipo, nombre: a.nombre }) %><% }) %>
                            </div>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="pagination">
          <span id="paginacionInfoOf">Mostrando <%= oficiosPend.length %> de <%= oficiosPend.length %></span>
        </div>
      </div>

      <!-- ═══════════════ TAB ATENDIDOS ═══════════════ -->
      <div id="tabAtendidos" class="content-card tab-panel" style="display:none">
        <div class="card-header">
          <div class="filters">
            <div class="search-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="searchAtendidos" placeholder="Buscar..." class="search-input">
            </div>
            <select id="filterUnidadAt" class="filter-select">
              <option value="">Todas las unidades</option>
              <option value="TODAS">TODAS</option>
              <% unidades.forEach(u => { %>
                <option value="<%= u.alias %>"><%= u.alias %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <% if (oficiosAt.length === 0) { %>
          <div class="empty-state-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <p>No hay oficios atendidos aún.</p>
          </div>
        <% } else { %>
          <table class="table" id="tablaAtendidos">
            <colgroup>
              <col style="width:48px">    <!-- icono tipo   -->
              <col style="width:13%">     <!-- No. Oficio   -->
              <col style="width:18%">     <!-- Remitente    -->
              <col style="width:34%">     <!-- Asunto       -->
              <col style="width:11%">     <!-- Fecha        -->
              <col style="width:8%">      <!-- Unidad       -->
              <col style="width:10%">     <!-- Respuestas   -->
              <col style="width:80px">    <!-- Acción       -->
            </colgroup>
             <thead>
               <tr>
                 <th></th>
                 <th>NO.</th>
                 <th>REMITENTE</th>
                 <th>ASUNTO</th>
                 <th>FECHA</th>
                 <th>UNIDAD</th>
                 <th>RESPUESTAS</th>
                 <th>ACCIÓN</th>
               </tr>
             </thead>

            <tbody id="tbodyAtendidos">
              <% oficiosAt.forEach(o => {
                 const respuestas = o.respuestas || [];
                 const totalResp = respuestas.length;
                 const initials = o.remitente ? o.remitente.slice(0,2).toUpperCase() : '??';
                 const esCorreo = (o.tipoArchivo === 1);
              %>
                <tr class="oficio-row at-row"
                  data-unidad="<%= o.unidadAlias || '' %>"
                  data-search="<%= (o.noOficio + ' ' + o.remitente + ' ' + o.asunto + ' ' + (o.unidadAlias || '')).toLowerCase() %>"
                  data-id="<%= o.id %>">

                 <script type="application/json" id="oficio-data-<%= o.id %>"><%- JSON.stringify({
                     id: o.id, noOficio: o.noOficio,
                     fechaOficio: o.fechaOficio || "", fechaRecibo: o.fechaRecibo || "",
                     fechaLimite: o.fechaLimite || "", asunto: o.asunto,
                     remitente: o.remitente, cargo: o.cargo || "",
                     dependencia: o.dependencia || "", unidadId: o.unidadId || "",
                     estatus: o.estatus, tipoArchivo: o.tipoArchivo || 0,
                     tieneArchivo: !!o.archivoPath,
                     archivoUrl: o.archivoUrl || ""
                   }).replace(/<\/script>/gi, '<\\/script>') %></script>


                  <td>
                    <% if (esCorreo) { %>
                      <span class="tipo-icon tipo-icon-correo" title="Correo electrónico">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                      </span>
                    <% } else { %>
                      <span class="tipo-icon tipo-icon-oficio" title="Oficio">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                      </span>
                    <% } %>
                  </td>

                  <td class="no-cell"><%= o.noOficio %></td>
                  <td><%- include('partials/user-cell', { name: o.remitente, initials: initials, cargo: o.cargo }) %></td>
                  <td class="asunto-cell"><%= o.asunto %></td>
                  <td class="fecha-cell"><%= o.fechaOficio ? new Date(o.fechaOficio).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'}) : '—' %></td>
                  <td><%= o.unidadAlias || '—' %></td>
                   <td>
                     <div class="respondido-cell">
                       <span class="respondido-fecha"><%= totalResp %> respuesta<%= totalResp !== 1 ? 's' : '' %></span>
                       <script type="application/json" id="resp-data-<%= o.id %>"><%- JSON.stringify(respuestas).replace(/<\/script>/gi,'<\/script>') %></script>
                       <script>
                         window.__respuestas = window.__respuestas || {};
                         window.__respuestas['<%= o.id %>'] = JSON.parse(document.getElementById('resp-data-<%= o.id %>').textContent);
                       </script>
                     </div>
                   </td>
                    <td class="actions-cell">
                      <button class="menu-btn" onclick="toggleActionMenu(event, '<%= o.id %>')" title="Acciones">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                      </button>
                    </td>
                    </tr>

              <% }) %>
            </tbody>
          </table>
          <div class="pagination">
            <span id="paginacionInfoAt">Mostrando <%= oficiosAt.length %> de <%= oficiosAt.length %></span>
          </div>
        <% } %>
      </div>

    </main>
  </div>

  <%# MODAL VISOR %>
  <%- include('partials/viewer-modal') %>

  <!-- ═══════════ MODAL REGISTRAR OFICIO ═══════════ -->
  <div class="modal-overlay" id="modalOficioOverlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Registrar Oficio</h3>
        <button class="modal-close" id="modalOficioClose">&times;</button>
      </div>
      <div class="modal-body">
        <p class="modal-error" id="modalOficioError"></p>
        <div class="form-group">
          <label class="check-row" for="inputEsCorreo">
            <input type="checkbox" id="inputEsCorreo">
            <span class="check-row-label">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Es correo electrónico
            </span>
          </label>
        </div>
        <div class="form-row">
          <div class="form-group"><label>No. Oficio</label><input type="text" id="inputNoOficio" placeholder="OF-2024-005"></div>
          <div class="form-group"><label>Fecha del Oficio</label><input type="date" id="inputFechaOficio"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Fecha de Recibo</label><input type="date" id="inputFechaRecibo"></div>
          <div class="form-group"><label>Fecha Límite</label><input type="date" id="inputFechaLimite"></div>
        </div>
        <div class="form-group"><label>Asunto</label><textarea id="inputAsunto" placeholder="Describa brevemente el asunto" rows="3"></textarea></div>
        <div class="form-row">
          <div class="form-group"><label>Remitente</label><input type="text" id="inputRemitente" placeholder="Nombre completo"></div>
          <div class="form-group"><label>Cargo</label><input type="text" id="inputCargo" placeholder="Cargo del remitente"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Dependencia</label><input type="text" id="inputDependencia" placeholder="Dependencia de origen"></div>
          <div class="form-group">
            <label>Unidad a Turnar</label>
            <select id="inputUnidadTurnar">
              <option value="" disabled selected>Seleccionar</option>
              <option value="TODAS" data-alias="TODAS">— Todas las unidades —</option>
              <% unidades.forEach(u => { %><option value="<%= u.id %>" data-alias="<%= u.alias %>"><%= u.uadname %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Adjuntar Oficio <span class="label-hint">(PDF, opcional)</span></label>
          <div class="file-drop" id="fileDrop">
            <input type="file" id="inputArchivo" accept="application/pdf" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            <span id="fileLabel">Seleccionar archivo PDF</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="btnOficioCancelar">Cancelar</button>
        <button class="btn-primary" id="btnOficioRegistrar">
          <span id="btnRegistrarText">Registrar</span>
          <span id="btnRegistrarLoader" class="loader" style="display:none"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════ MODAL EDITAR OFICIO ═══════════ -->
  <div class="modal-overlay" id="modalEditarOverlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Editar Oficio</h3>
        <button class="modal-close" id="modalEditarClose">&times;</button>
      </div>
      <div class="modal-body">
        <p class="modal-error" id="modalEditarError"></p>
        <div class="form-group">
          <label class="check-row" for="editEsCorreo">
            <input type="checkbox" id="editEsCorreo">
            <span class="check-row-label">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Es correo electrónico
            </span>
          </label>
        </div>
        <div class="form-row">
          <div class="form-group"><label>No. Oficio</label><input type="text" id="editNoOficio" placeholder="OF-2024-005"></div>
          <div class="form-group"><label>Fecha del Oficio</label><input type="date" id="editFechaOficio"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Fecha de Recibo</label><input type="date" id="editFechaRecibo"></div>
          <div class="form-group"><label>Fecha Límite</label><input type="date" id="editFechaLimite"></div>
        </div>
        <div class="form-group"><label>Asunto</label><textarea id="editAsunto" placeholder="Describa brevemente el asunto" rows="3"></textarea></div>
        <div class="form-row">
          <div class="form-group"><label>Remitente</label><input type="text" id="editRemitente" placeholder="Nombre completo"></div>
          <div class="form-group"><label>Cargo</label><input type="text" id="editCargo" placeholder="Cargo del remitente"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Dependencia</label><input type="text" id="editDependencia" placeholder="Dependencia de origen"></div>
          <div class="form-group">
            <label>Unidad a Turnar</label>
            <select id="editUnidadTurnar">
              <option value="" disabled>Seleccionar</option>
              <option value="TODAS" data-alias="TODAS">— Todas las unidades —</option>
              <% unidades.forEach(u => { %><option value="<%= u.id %>" data-alias="<%= u.alias %>"><%= u.uadname %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Estatus</label>
            <select id="editEstatus"><option value="Pendiente">Pendiente</option><option value="Atendido">Atendido</option></select>
          </div>
        </div>
        <div class="form-group">
          <label>Reemplazar PDF <span class="label-hint" id="editArchivoHint">(opcional)</span></label>
          <div class="file-drop" id="editFileDrop">
            <input type="file" id="editArchivo" accept="application/pdf" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            <span id="editFileLabel">Seleccionar archivo PDF</span>
          </div>
          <p class="label-hint" id="editArchivoActual" style="margin-top:4px; display:none">Este oficio ya tiene un PDF adjunto. Si subes uno nuevo lo reemplazará.</p>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="btnEditarCancelar">Cancelar</button>
        <button class="btn-primary" id="btnEditarGuardar">
          <span id="btnEditarText">Guardar cambios</span>
          <span id="btnEditarLoader" class="loader" style="display:none"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════ MODAL RESPUESTAS ═══════════ -->
  <div class="modal-overlay" id="modalRespuestasOverlay">
    <div class="modal modal-respuestas">
      <div class="modal-header">
        <h3 id="modalRespuestasTitulo">Respuestas</h3>
        <button class="modal-close" id="modalRespuestasClose">&times;</button>
      </div>
      <div class="modal-body">
        <div id="listaRespuestasModal"></div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="btnRespuestasCerrar">Cerrar</button>
      </div>
    </div>
  </div>

  <script src="/js/viewer.js"></script>
  <script src="/js/dashboardaof.js"></script>

<%- include('partials/footer') %>
