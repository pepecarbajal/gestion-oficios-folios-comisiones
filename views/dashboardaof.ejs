        <button class="modal-close" id="modalRegistrarFolioAofClose">&times;</button>
      </div>
      <div class="modal-body">
        <p class="modal-error" id="modalRegistrarFolioAofError"></p>
        <div class="form-group">
          <label>No. Folio</label>
          <input type="text" id="inputFolAofNoFolio" placeholder="Número de folio" maxlength="4">
        </div>
        <div class="form-group">
          <label>Destinatario</label>
          <input type="text" id="inputFolAofDestinatario" placeholder="Nombre del destinatario">
        </div>
        <div class="form-group">
          <label>Dependencia</label>
          <input type="text" id="inputFolAofDependencia" placeholder="Dependencia">
        </div>
        <div class="form-group">
          <label>Cargo</label>
          <input type="text" id="inputFolAofCargo" placeholder="Cargo del destinatario">
        </div>
        <div class="form-group">
          <label>Asunto</label>
          <textarea id="inputFolAofAsunto" placeholder="Asunto del folio" rows="3"></textarea>
        </div>
        <div class="form-group">
          <label>Turnar a unidad(es)</label>
          <button type="button" class="btn-selector-unidad" id="btnFolAofSelectorUnidad" onclick="abrirSelectorUnidadesFolios()">
            <span id="btnFolAofUnidadText">Seleccionar unidades</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="btnRegistrarFolioAofCancelar">Cancelar</button>
        <button class="btn-primary" id="btnRegistrarFolioAofGuardar">
          <span id="btnRegistrarFolioAofText">Registrar</span>
          <span id="btnRegistrarFolioAofLoader" class="loader" style="display:none"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════ MODAL SELECTOR DE UNIDADES ═══════════ -->
  <div class="modal-overlay" id="modalSelectorUnidades">
    <div class="modal modal-selector-unidades">
      <div class="modal-header">
        <h3>Seleccionar unidades</h3>
        <button class="modal-close" id="modalSelectorClose">&times;</button>
      </div>
      <div class="modal-body">
        <div class="selector-search">
          <input type="text" id="searchUnidadesSelector" placeholder="Buscar unidad..." autocomplete="off">
        </div>
        <div class="selector-list" id="selectorList">
          <div class="selector-item selector-item-todas" data-value="__TODAS__">
            <div class="selector-check">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="selector-item-text">— Todas las unidades —</span>
          </div>
          <% unidades.forEach(u => { %>
            <div class="selector-item" data-value="<%= u.id %>" data-alias="<%= u.alias %>" data-search="<%= (u.uadname + ' ' + u.alias).toLowerCase() %>">
              <div class="selector-check">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="selector-item-text"><%= u.uadname %></span>
              <span class="selector-item-alias"><%= u.alias %></span>
            </div>
          <% }) %>
        </div>
        <div class="selector-empty" id="selectorEmpty" style="display:none">No se encontraron unidades.</div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="btnSelectorCancelar">Cancelar</button>
        <button class="btn-primary" id="btnSelectorAplicar">Aplicar</button>
      </div>
    </div>
  </div>

  <script src="/js/viewer.js"></script>
  <script src="/js/aof/dashboardaof.js"></script>

<%- include('partials/footer') %>
