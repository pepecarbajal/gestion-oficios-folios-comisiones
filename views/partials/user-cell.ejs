<div class="user-cell">
  <div>
    <strong><%= name %></strong>
    <% if (typeof cargo !== 'undefined' && cargo) { %>
      <span class="sub"><%= cargo %></span>
    <% } %>
    <% if (typeof dependencia !== 'undefined' && dependencia) { %>
      <span class="sub sub-dependencia"><%= dependencia %></span>
    <% } %>
  </div>
</div>